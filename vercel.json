{
  "functions": {
    "app/api/parse/route.ts": {
      "maxDuration": 30
    },
    "app/api/create-task/route.ts": {
      "maxDuration": 15
    },
    "app/api/telegram/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/briefing/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sera/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/mail/route.ts": {
      "maxDuration": 300
    }
  },
  "schedules": {
    "briefing-mattina": {
      "schedule": "0 8 * * *",
      "timezone": "Europe/Rome",
      "path": "/api/cron/briefing",
      "requestMethod": "GET"
    },
    "mail-pomeriggio": {
      "schedule": "0 14 * * *",
      "timezone": "Europe/Rome",
      "path": "/api/cron/mail",
      "requestMethod": "GET"
    },
    "piano-sera": {
      "schedule": "0 21 * * *",
      "timezone": "Europe/Rome",
      "path": "/api/cron/sera",
      "requestMethod": "GET"
    }
  }
}
